# Optional voice connection. Terminal chats do not require this key.
OPENAI_API_KEY=

# Optional fal.ai generation account.
FAL_KEY=

# Optional coordinator model override; blank uses the Codex account default.
MRMAK_COORDINATOR_MODEL=

# Optional mobile dictation provider. Used only when you record and transcribe.
OPENROUTER_API_KEY=

# Optional dictation overrides: openrouter, openai, or off.
# Blank selects OpenRouter when configured, otherwise OpenAI.
MRMAK_TRANSCRIBE_PROVIDER=
# Blank uses openai/gpt-4o-transcribe (OpenRouter) or gpt-4o-transcribe (OpenAI).
MRMAK_TRANSCRIBE_MODEL=

# Optional local Studio router override; e.g. non-thinking Qwen3 Instruct.
# Default: qwen3.5:4b-q4_K_M
MRMAK_STUDIO_ROUTER_MODEL=
